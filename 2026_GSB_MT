<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>구약석의 방법론 · 중간고사 모의고사</title>
<style>
:root{
  --bg:#EDF0F3; --surface:#FFFFFF; --ink:#1B2430; --muted:#5B6675; --line:#D5DBE2;
  --accent:#2E4A7A; --accent-soft:#E3E9F3; --ok:#2C7A57; --ok-soft:#E2F2EA; --bad:#B0413A; --bad-soft:#F8E6E4;
  --serif:"Noto Serif KR","Nanum Myeongjo","AppleMyungjo","Batang",serif;
  --sans:-apple-system,BlinkMacSystemFont,"Apple SD Gothic Neo","Pretendard","Noto Sans KR","Malgun Gothic",sans-serif;
  --heb:"SBL Hebrew","Ezra SIL","Noto Serif Hebrew","Times New Roman",serif;
}
@media (prefers-color-scheme: dark){:root{
  --bg:#141A22; --surface:#1D2530; --ink:#E6EAF0; --muted:#9AA6B5; --line:#2F3A48;
  --accent:#8FB0E6; --accent-soft:#25324A; --ok:#6CC59A; --ok-soft:#1E3A2E; --bad:#E58A82; --bad-soft:#40241F;
}}
*{box-sizing:border-box}
html,body{margin:0;background:var(--bg);color:var(--ink);font-family:var(--sans);-webkit-text-size-adjust:100%}
body{padding:env(safe-area-inset-top,0) 0 env(safe-area-inset-bottom,0)}
.wrap{max-width:680px;margin:0 auto;padding:20px 16px 48px}
h1{font-family:var(--serif);font-size:1.6rem;line-height:1.3;margin:8px 0 4px;font-weight:700}
.sub{color:var(--muted);font-size:.92rem;margin:0 0 22px}
.panel{background:var(--surface);border:1px solid var(--line);border-radius:14px;padding:18px;margin-bottom:14px}
.panel h2{font-size:.98rem;margin:0 0 12px;font-weight:700}
.chips{display:flex;flex-wrap:wrap;gap:8px}
.chip{border:1px solid var(--line);background:transparent;color:var(--ink);border-radius:999px;padding:8px 14px;font-size:.92rem;cursor:pointer;font-family:inherit}
.chip small{color:var(--muted);margin-left:4px}
.chip.on{background:var(--accent);border-color:var(--accent);color:#fff}
.chip.on small{color:rgba(255,255,255,.75)}
@media (prefers-color-scheme: dark){.chip.on{color:#141A22}.chip.on small{color:rgba(20,26,34,.7)}}
.row{display:flex;align-items:center;justify-content:space-between;gap:12px}
input[type=range]{width:100%;accent-color:var(--accent);margin-top:10px}
.big{font-size:1.5rem;font-weight:700;font-variant-numeric:tabular-nums}
.btn{display:block;width:100%;border:none;border-radius:12px;padding:15px;font-size:1rem;font-weight:700;cursor:pointer;font-family:inherit;background:var(--accent);color:#fff}
@media (prefers-color-scheme: dark){.btn{color:#141A22}}
.btn.ghost{background:transparent;color:var(--accent);border:1px solid var(--accent)}
.btn:disabled{opacity:.4;cursor:default}
.btns{display:grid;gap:10px;margin-top:14px}
.top{display:flex;align-items:center;gap:12px;margin-bottom:14px}
.bar{flex:1;height:6px;background:var(--line);border-radius:3px;overflow:hidden}
.bar i{display:block;height:100%;background:var(--accent);transition:width .25s}
.count{font-variant-numeric:tabular-nums;font-size:.9rem;color:var(--muted);white-space:nowrap}
.x{background:none;border:none;color:var(--muted);font-size:.9rem;cursor:pointer;font-family:inherit;padding:4px}
.meta{display:flex;gap:8px;align-items:center;margin-bottom:10px;font-size:.82rem;color:var(--muted)}
.meta b{color:var(--accent);font-size:.95rem}
.tag{border:1px solid var(--line);border-radius:6px;padding:2px 8px}
.q{font-family:var(--serif);font-size:1.12rem;line-height:1.75;margin:0 0 14px;font-weight:600;word-break:keep-all}
.box{white-space:pre-line;border-left:3px solid var(--accent);background:var(--accent-soft);padding:12px 14px;border-radius:0 8px 8px 0;font-size:.93rem;line-height:1.75;margin-bottom:16px;word-break:keep-all;unicode-bidi:plaintext}
.heb{font-family:var(--heb);font-size:1.25em;direction:rtl;unicode-bidi:isolate}
.opts{display:grid;gap:9px}
.opt{display:flex;gap:10px;align-items:flex-start;text-align:left;width:100%;background:var(--surface);color:var(--ink);border:1px solid var(--line);border-radius:12px;padding:13px 14px;font-size:.98rem;line-height:1.55;cursor:pointer;font-family:inherit;word-break:keep-all}
.opt .no{flex:none;font-weight:700;color:var(--muted);min-width:1.2em}
.opt:not(:disabled):hover{border-color:var(--accent)}
.opt.ok{border-color:var(--ok);background:var(--ok-soft)}
.opt.ok .no{color:var(--ok)}
.opt.bad{border-color:var(--bad);background:var(--bad-soft)}
.opt.bad .no{color:var(--bad)}
.opt:disabled{cursor:default}
.fb{margin-top:14px;border-radius:12px;padding:14px;line-height:1.7;font-size:.94rem;word-break:keep-all}
.fb.ok{background:var(--ok-soft)}.fb.bad{background:var(--bad-soft)}
.fb strong{display:block;margin-bottom:4px}
.fb.ok strong{color:var(--ok)}.fb.bad strong{color:var(--bad)}
.score{text-align:center;padding:28px 18px}
.score .emo{font-size:3rem}
.score .num{font-family:var(--serif);font-size:2.6rem;font-weight:700;margin:6px 0 2px}
.score p{margin:4px 0;color:var(--muted)}
.brk{width:100%;border-collapse:collapse;font-size:.92rem}
.brk td{padding:8px 0;border-bottom:1px solid var(--line)}
.brk td:last-child{text-align:right;font-variant-numeric:tabular-nums}
.rv{border-top:1px solid var(--line);padding:16px 0}
.rv:first-child{border-top:none;padding-top:0}
.rv .q{font-size:1rem;margin-bottom:10px}
.rv .line{font-size:.92rem;line-height:1.65;margin:4px 0;word-break:keep-all}
.rv .line.me{color:var(--bad)}.rv .line.ans{color:var(--ok);font-weight:600}
.rv .exp{font-size:.9rem;color:var(--muted);line-height:1.65;margin-top:6px}
.empty{color:var(--muted);text-align:center;padding:20px 0}
.hide{display:none}
:focus-visible{outline:2px solid var(--accent);outline-offset:2px}
</style>
</head>
<body>
<div class="wrap">

<section id="home">
  <h1>구약석의 방법론<br>중간고사 모의고사</h1>
  <p class="sub">2026학년도 2학기 · 객관식 <span id="total"></span>문항</p>

  <div class="panel">
    <h2>문항 세트</h2>
    <div class="chips" id="sets"></div>
  </div>
  <div class="panel">
    <h2>주제</h2>
    <div class="chips" id="topics"></div>
  </div>
  <div class="panel">
    <h2>순서</h2>
    <div class="chips" id="orders"></div>
  </div>
  <div class="panel">
    <div class="row"><h2 style="margin:0">문항 수</h2><span class="big" id="cntLabel">0</span></div>
    <input type="range" id="cnt" min="1" max="1" value="1">
    <div class="row count"><span>1</span><span id="cntMax">1</span></div>
  </div>
  <button class="btn" id="startBtn">시작하기</button>
</section>

<section id="quiz" class="hide">
  <div class="top">
    <button class="x" id="quitBtn">그만하기</button>
    <div class="bar"><i id="barFill"></i></div>
    <span class="count" id="progress"></span>
  </div>
  <div class="panel">
    <div class="meta"><b id="qNo"></b><span class="tag" id="qTopic"></span><span class="tag" id="qSet"></span></div>
    <p class="q" id="qText"></p>
    <div class="box hide" id="qBox"></div>
    <div class="opts" id="opts"></div>
    <div class="fb hide" id="fb"></div>
  </div>
  <button class="btn hide" id="nextBtn">다음 문제</button>
</section>

<section id="result" class="hide">
  <div class="panel score">
    <div class="emo" id="emo"></div>
    <div class="num" id="scoreNum"></div>
    <p id="scoreTxt"></p>
  </div>
  <div class="panel">
    <h2>주제별 결과</h2>
    <table class="brk" id="brk"></table>
  </div>
  <div class="btns">
    <button class="btn" id="reviewBtn">오답노트 보기</button>
    <button class="btn ghost" id="retryBtn">틀린 문제만 다시 풀기</button>
    <button class="btn ghost" id="homeBtn">처음으로</button>
  </div>
</section>

<section id="review" class="hide">
  <div class="top"><button class="x" id="backBtn">← 결과로</button></div>
  <h1 style="font-size:1.3rem">오답노트</h1>
  <p class="sub" id="rvSub"></p>
  <div class="panel" id="rvList"></div>
  <div class="btns">
    <button class="btn" id="retryBtn2">틀린 문제만 다시 풀기</button>
    <button class="btn ghost" id="homeBtn2">처음으로</button>
  </div>
</section>

</div>
