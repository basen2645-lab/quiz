  SETS.forEach(([k,l])=>{
    const n=DATA.filter(q=>k==="all"||q.set===k).length;
    sets.appendChild(chip(l, st.set===k, ()=>{st.set=k;renderHome();}, n));
  });
  const tp=$("topics"); tp.innerHTML="";
  const allOn=st.topics.size===TOPICS.length;
  tp.appendChild(chip("전체", allOn, ()=>{st.topics=allOn?new Set():new Set(TOPICS.map(t=>t[0]));renderHome();}));
  TOPICS.forEach(([k,l])=>{
    const n=DATA.filter(q=>q.t===k&&(st.set==="all"||q.set===st.set)).length;
    tp.appendChild(chip(l, st.topics.has(k), ()=>{st.topics.has(k)?st.topics.delete(k):st.topics.add(k);renderHome();}, n));
  });
  const od=$("orders"); od.innerHTML="";
  [["random","무작위"],["seq","번호순"]].forEach(([k,l])=>od.appendChild(chip(l, st.order===k, ()=>{st.order=k;renderHome();})));
  const max=pool().length, r=$("cnt");
  r.max=Math.max(max,1); r.disabled=max===0;
  if(st.count>max) st.count=max; if(st.count<1&&max>0) st.count=Math.min(20,max);
  r.value=st.count; $("cntLabel").textContent=max?st.count:0; $("cntMax").textContent=max;
  $("startBtn").disabled=max===0;
  $("startBtn").textContent=max?`${st.count}문항 시작하기`:"주제를 하나 이상 고르세요";
}
$("cnt").oninput=e=>{st.count=+e.target.value;$("cntLabel").textContent=st.count;$("startBtn").textContent=`${st.count}문항 시작하기`;};

function shuffle(a){a=a.slice();for(let i=a.length-1;i>0;i--){const j=Math.floor(Math.random()*(i+1));[a[i],a[j]]=[a[j],a[i]];}return a;}
function show(id){["home","quiz","result","review"].forEach(s=>$(s).classList.toggle("hide",s!==id));window.scrollTo(0,0);}

function start(list){
  run={list, i:0, answers:[]};
  show("quiz"); renderQ();
}
$("startBtn").onclick=()=>{
  let p=pool();
  p = st.order==="random" ? shuffle(p).slice(0,st.count) : p.slice(0,st.count);
  start(p);
};

const HEB=/[\u0590-\u05FF][\u0590-\u05FF\s]*[\u0590-\u05FF]|[\u0590-\u05FF]/g;
function setRich(el, text){
  el.innerHTML="";
  let last=0; text.replace(HEB,(m,off)=>{
    if(off>last) el.appendChild(document.createTextNode(text.slice(last,off)));
    const s=document.createElement("span"); s.className="heb"; s.dir="rtl"; s.textContent=m; el.appendChild(s);
    last=off+m.length; return m;
  });
  if(last<text.length) el.appendChild(document.createTextNode(text.slice(last)));
}

function renderQ(){
  const q=run.list[run.i], n=run.list.length;
  $("progress").textContent=`${run.i+1} / ${n}`;
  $("barFill").style.width=`${(run.i/n)*100}%`;
  $("qNo").textContent=q.n+"번";
  $("qTopic").textContent=TNAME[q.t];
  $("qSet").textContent=SETNAME[q.set];
  $("qText").textContent=q.q;
  const box=$("qBox");
  if(q.x){box.classList.remove("hide");setRich(box,q.x);}else box.classList.add("hide");
  const os=$("opts"); os.innerHTML="";
  q.o.forEach((t,k)=>{
    const b=document.createElement("button"); b.className="opt";
    const no=document.createElement("span"); no.className="no"; no.textContent=NUMS[k];
    const tx=document.createElement("span"); setRich(tx,t);
    b.append(no,tx); b.onclick=()=>pick(k); os.appendChild(b);
  });
  $("fb").className="fb hide"; $("nextBtn").classList.add("hide");
}
function pick(k){
  const q=run.list[run.i], ok=k===q.a;
  run.answers[run.i]=k;
  [...$("opts").children].forEach((b,j)=>{
    b.disabled=true;
    if(j===q.a) b.classList.add("ok");
    else if(j===k) b.classList.add("bad");
  });
  const fb=$("fb"); fb.className="fb "+(ok?"ok":"bad"); fb.innerHTML="";
  const s=document.createElement("strong");
  s.textContent= ok ? "정답입니다" : `오답입니다 · 정답 ${NUMS[q.a]}`;
  const p=document.createElement("div"); setRich(p,q.e);
  fb.append(s,p);
  const nb=$("nextBtn"); nb.classList.remove("hide");
  nb.textContent = run.i===run.list.length-1 ? "결과 보기" : "다음 문제";
  nb.focus({preventScroll:true});
  fb.scrollIntoView({behavior:"smooth",block:"nearest"});
}
$("nextBtn").onclick=()=>{
  if(run.i<run.list.length-1){run.i++;renderQ();window.scrollTo(0,0);}
  else finish();
};
$("quitBtn").onclick=()=>{
  if(run.answers.filter(a=>a!==undefined).length===0){show("home");renderHome();return;}
  if(confirm("지금까지 푼 문제로 결과를 볼까요?")){run.list=run.list.slice(0,run.answers.length);finish();}
};

function wrongs(){return run.list.filter((q,i)=>run.answers[i]!==q.a);}
function finish(){
  const n=run.list.length, c=n-wrongs().length, pct=n?Math.round(c/n*100):0;
  $("emo").textContent = pct===100?"🏆":pct>=90?"🎉":pct>=80?"😊":pct>=70?"🙂":pct>=50?"😅":"📖";
  $("scoreNum").textContent=`${c} / ${n}`;
  $("scoreTxt").textContent = `정답률 ${pct}% · ` + (pct===100?"완벽합니다!":pct>=90?"시험 준비 끝이 보여요.":pct>=80?"아주 좋아요.":pct>=70?"조금만 더 다지면 돼요.":pct>=50?"오답노트로 약한 주제를 확인하세요.":"해설을 읽으며 한 번 더 풀어 보세요.");
  const t=$("brk"); t.innerHTML="";
  TOPICS.forEach(([k,l])=>{
    const qs=run.list.map((q,i)=>[q,i]).filter(([q])=>q.t===k); if(!qs.length) return;
    const cc=qs.filter(([q,i])=>run.answers[i]===q.a).length;
    const tr=document.createElement("tr");
    tr.innerHTML=`<td></td><td></td>`; tr.children[0].textContent=l; tr.children[1].textContent=`${cc} / ${qs.length}`;
    t.appendChild(tr);
  });
  const w=wrongs().length;
  $("reviewBtn").disabled=w===0; $("retryBtn").disabled=w===0;
  $("reviewBtn").textContent= w?`오답노트 보기 (${w})`:"틀린 문제가 없어요";
  show("result");
}
function renderReview(){
  const L=$("rvList"); L.innerHTML="";
  const ws=run.list.map((q,i)=>[q,run.answers[i]]).filter(([q,a])=>a!==q.a);
  $("rvSub").textContent=`틀린 문제 ${ws.length}개`;
  if(!ws.length){L.innerHTML='<p class="empty">틀린 문제가 없어요.</p>';return;}
  ws.forEach(([q,a])=>{
    const d=document.createElement("div"); d.className="rv";
    const m=document.createElement("div"); m.className="meta";
    m.innerHTML='<b></b><span class="tag"></span>'; m.children[0].textContent=q.n+"번"; m.children[1].textContent=TNAME[q.t];
    const p=document.createElement("p"); p.className="q"; p.textContent=q.q;
    d.append(m,p);
    if(q.x){const b=document.createElement("div");b.className="box";setRich(b,q.x);d.appendChild(b);}
    const me=document.createElement("div"); me.className="line me"; setRich(me,`내 답 ${NUMS[a]} ${q.o[a]}`);
    const an=document.createElement("div"); an.className="line ans"; setRich(an,`정답 ${NUMS[q.a]} ${q.o[q.a]}`);
    const ex=document.createElement("div"); ex.className="exp"; setRich(ex,q.e);
    d.append(me,an,ex); L.appendChild(d);
  });
}
$("reviewBtn").onclick=()=>{renderReview();show("review");};
$("backBtn").onclick=()=>show("result");
const retry=()=>start(shuffle(wrongs()));
$("retryBtn").onclick=retry; $("retryBtn2").onclick=retry;
const home=()=>{show("home");renderHome();};
$("homeBtn").onclick=home; $("homeBtn2").onclick=home;
renderHome();
</script>
</body>
</html>
