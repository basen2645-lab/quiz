  document.getElementById('range-max').textContent=pool.length;
  if(parseInt(sl.value)>pool.length) { sl.value=pool.length; updateCount(pool.length); }
  const t=QUESTIONS.length, m=QUESTIONS.filter(q=>q.type==='mc').length;
  const s=QUESTIONS.filter(q=>q.type==='sa').length, o=QUESTIONS.filter(q=>q.type==='ox').length;
  document.getElementById('home-sub').textContent=`기말고사 모의고사 · 총 ${f==='all'?t:f==='mc'?m:f==='sa'?s:o}문제`;
}
function updateCount(v){document.getElementById('count-display').textContent=v;}
function shuffle(arr){const a=[...arr];for(let i=a.length-1;i>0;i--){const j=Math.floor(Math.random()*(i+1));[a[i],a[j]]=[a[j],a[i]];}return a;}
function getSection(id){return SECTIONS.find(s=>id>=s.start&&id<=s.end);}

function startQuiz(){
  const pool=getPool();
  const n=parseInt(document.getElementById('count-slider').value);
  quizQ=shuffle(pool).slice(0,Math.min(n,pool.length));
  current=0;selected=null;revealed=false;results=[];score=0;scoreMax=0;
  show('quiz'); renderQ();
}
function show(id){
  ['home','quiz','review'].forEach(s=>{
    const el=document.getElementById(s);
    el.style.display=s===id?(s==='home'?'flex':'block'):'none';
  });
}
function goHome(){show('home');}

function renderQ(){
  const q=quizQ[current];
  const isOX=q.type==='ox', isSA=q.type==='sa', isMC=q.type==='mc';
  selected=null; revealed=false;

  document.getElementById('q-counter').textContent=`${current+1} / ${quizQ.length}`;
  document.getElementById('score-badge').textContent=`${score} 점`;
  document.getElementById('progress-fill').style.width=`${(current/quizQ.length)*100}%`;

  const sec=getSection(q.id);
  document.getElementById('section-label').textContent=sec?sec.name:'';

  const badge=document.getElementById('type-badge');
  if(isMC){badge.className='type-badge type-mc';badge.textContent='객관식';}
  else if(isSA){badge.className='type-badge type-sa';badge.textContent='단답형';}
  else{badge.className='type-badge type-ox';badge.textContent='O / X';}

  document.getElementById('q-text').textContent=q.question;

  document.getElementById('choices').style.display=isMC?'block':'none';
  document.getElementById('ox-btns').style.display=isOX?'flex':'none';
  document.getElementById('sa-wrap').style.display=isSA?'block':'none';

  if(isMC){
    const div=document.getElementById('choices'); div.innerHTML='';
    q.choices.forEach((ch,i)=>{
      const btn=document.createElement('button');
      btn.className='choice-btn';
      btn.innerHTML=`<span class="choice-label">${LABELS[i]}</span><span style="flex:1">${ch.replace(/</g,'&lt;')}</span><span class="choice-mark"></span>`;
      btn.onclick=()=>selectChoice(i);
      div.appendChild(btn);
    });
  } else if(isOX){
    document.getElementById('ox-o').className='ox-btn';
    document.getElementById('ox-x').className='ox-btn';
  } else {
    const inp=document.getElementById('sa-input');
    inp.value=''; inp.disabled=false;
    document.getElementById('sa-answer-box').style.display='none';
    document.getElementById('sa-answer-text').textContent='';
    document.getElementById('btn-show-ans').style.display='block';
    document.getElementById('btn-show-ans').disabled=false;
  }

  const fb=document.getElementById('feedback');
  fb.style.display='none'; fb.className='feedback';
  document.getElementById('explanation').className='explanation';

  const btnC=document.getElementById('btn-confirm');
  btnC.style.display=isSA?'none':'block';
  btnC.disabled=true;
  document.getElementById('btn-next').style.display='none';
}

function selectChoice(i){
  if(revealed)return;
  selected=i;
  document.querySelectorAll('.choice-btn').forEach((b,idx)=>b.classList.toggle('selected',idx===i));
  document.getElementById('btn-confirm').disabled=false;
}
function selectOX(v){
  if(revealed)return;
  selected=v;
  document.getElementById('ox-o').className='ox-btn'+(v==='O'?' selected':'');
  document.getElementById('ox-x').className='ox-btn'+(v==='X'?' selected':'');
  document.getElementById('btn-confirm').disabled=false;
}
function onSAInput(){
  // SA: just enable next (we use show-answer flow)
}
function showSAAnswer(){
  const q=quizQ[current];
  document.getElementById('sa-input').disabled=true;
  const box=document.getElementById('sa-answer-box');
  box.style.display='block';
  document.getElementById('sa-answer-text').textContent=q.answer;
  document.getElementById('btn-show-ans').style.display='none';
  // Show explanation
  if(q.explanation){
    const exp=document.getElementById('explanation');
    exp.className='explanation show';
    document.getElementById('exp-text').textContent=q.explanation;
  }
  // SA counts as "seen" - score +0.5 for showing answer
  scoreMax++;
  results.push({qid:q.id,correct:'sa',selected:'shown',answer:q.answer});
  score += 0; // SA doesn't add to score automatically
  document.getElementById('score-badge').textContent=`${score} 점`;
  document.getElementById('btn-next').style.display='block';
  document.getElementById('btn-next').textContent=current+1>=quizQ.length?'결과 보기 →':'다음 문제 →';
}

function confirmAnswer(){
  if(selected===null)return;
  revealed=true;
  const q=quizQ[current];
  const isOX=q.type==='ox';
  const correct = isOX ? selected===q.answer : selected===q.answer-1;
  scoreMax++;
  if(correct) score++;
  results.push({qid:q.id,correct:correct?'yes':'no',selected,answer:q.answer,type:q.type});

  if(!isOX){
    document.querySelectorAll('.choice-btn').forEach((b,i)=>{
      b.classList.remove('selected');
      const mark=b.querySelector('.choice-mark');
      if(i===q.answer-1){b.classList.add('correct');mark.textContent='✓';}
      else if(i===selected){b.classList.add('wrong');mark.textContent='✗';}
      b.disabled=true;
    });
  } else {
    ['O','X'].forEach(v=>{
      const el=document.getElementById('ox-'+v.toLowerCase());
      el.classList.remove('selected');
      if(v===q.answer) el.classList.add('correct');
      else if(v===selected) el.classList.add('wrong');
      el.disabled=true;
    });
  }

  const fb=document.getElementById('feedback');
  fb.style.display='block';
  if(correct){
    fb.className='feedback correct'; fb.textContent='✓ 정답입니다!';
  } else {
    fb.className='feedback wrong';
    const ans = isOX ? q.answer : LABELS[q.answer-1];
    fb.textContent=`✗ 오답 — 정답: ${ans}`;
  }

  if(q.explanation){
    const exp=document.getElementById('explanation');
    exp.className='explanation show';
    document.getElementById('exp-text').textContent=q.explanation;
  }

  document.getElementById('score-badge').textContent=`${score} 점`;
  document.getElementById('btn-confirm').style.display='none';
  const btnN=document.getElementById('btn-next');
  btnN.style.display='block';
  btnN.textContent=current+1>=quizQ.length?'결과 보기 →':'다음 문제 →';
}

function nextQuestion(){
  if(current+1>=quizQ.length){showReview();}
  else{current++; renderQ();}
}

function showReview(){
  show('review');
  const gradeable = results.filter(r=>r.correct==='yes'||r.correct==='no');
  const total = gradeable.length;
  const saCount = results.filter(r=>r.correct==='sa').length;
  const pct = total>0 ? Math.round((score/total)*100) : 0;
  const wrong = results.filter(r=>r.correct==='no');

  document.getElementById('result-emoji').textContent=pct>=80?'🎉':pct>=60?'💪':'📖';
  document.getElementById('result-score').textContent=total>0?pct+'점':'--';
  document.getElementById('result-sub').innerHTML=
    (total>0?`채점 ${total}문제 중 <span class="ok">${score}개</span> 정답 · 오답 <span class="bad">${wrong.length}개</span>`:'') +
    (saCount>0?` · 단답형 <span class="skip">${saCount}개</span> 확인`:'');

  const list=document.getElementById('wrong-list');
  list.innerHTML='';
  if(wrong.length>0){
    const t=document.createElement('p');t.className='wrong-title';t.textContent=`✗ 틀린 문제 복습 (${wrong.length}개)`;list.appendChild(t);
    wrong.forEach(r=>{
      const q=quizQ.find(q=>q.id===r.qid); if(!q)return;
      const div=document.createElement('div'); div.className='wrong-item';
      const typeLabel=q.type==='mc'?'객관식':'OX';
      let inner=`<div class="wrong-type">${typeLabel} · Q${q.id}</div><p class="wrong-q">${q.question.replace(/</g,'&lt;')}</p>`;
      if(q.type==='mc'){
        inner+=q.choices.map((ch,i)=>{
          const isC=i===q.answer-1,isW=i===r.selected;
          const cls=isC?'correct':isW?'wrong':'';
          const mark=isC?' ✓':isW?' ✗':'';
          return `<div class="review-choice ${cls}"><span style="font-weight:700;min-width:20px">${LABELS[i]}</span><span style="flex:1">${ch.replace(/</g,'&lt;')}${mark}</span></div>`;
        }).join('');
      } else {
        inner+='<div class="review-ox">'+['O','X'].map(v=>{
          const isC=v===q.answer,isW=v===r.selected&&!isC;
          return `<div class="review-ox-btn ${isC?'correct':isW?'wrong':''}">${v}</div>`;
        }).join('')+'</div>';
      }
      if(q.explanation) inner+=`<div class="review-exp">📖 ${q.explanation}</div>`;
      div.innerHTML=inner; list.appendChild(div);
    });
  } else if(gradeable.length>0) {
    const p=document.createElement('p');p.style.cssText='color:#3a6080;text-align:center;padding:20px';p.textContent='🎊 채점된 문제 모두 정답!';list.appendChild(p);
  }
}

// Init
(function(){
  const t=QUESTIONS.length;
  document.getElementById('home-sub').textContent=`기말고사 모의고사 · 총 ${t}문제`;
  document.getElementById('range-max').textContent=t;
  document.getElementById('count-slider').max=t;
})();
</script>
</body>
</html>
